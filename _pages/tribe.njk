---
pagination:
  data: species.tribeList
  size: 1
  alias: tribe
permalink: "/species/tribe/{{ tribe.tribe }}/"
eleventyComputed:
  title: "{{ tribe.tribe }} — BeeAtlas"
layout: default.njk
---
<article class="taxon-page">
  {# Ladder built in _data/species.js — same builder every taxon page uses.
     Whitespace between crumbs is deliberate: it is the only wrap opportunity in
     the chain, and without it the full ladder overflows a phone viewport. #}
  <nav class="breadcrumb">
    {% for crumb in tribe.crumbs %}
    {%- if not loop.first %}<span class="sep">/</span> {% endif -%}
    {% if crumb.href %}<a href="{{ crumb.href }}">{{ crumb.label }}</a>{% else %}{{ crumb.label }}{% endif %}
    {% endfor %}
  </nav>
  <h1>{{ tribe.tribe }}</h1>
  <p class="metadata">{{ tribe.generaCount | quantify("genus", "genera") }} · {{ tribe.totalOccurrences | quantify("record") }}</p>
  <div class="media-grid">
    <img loading="lazy"
         src="/data/species-maps/tribe/{{ tribe.tribe }}.svg"
         alt="Occurrence map for tribe {{ tribe.tribe }}"
         style="aspect-ratio: 15/8; width: 100%;">
    <ul class="species-list">
    {%- for g in tribe.genera -%}
      <li>
        <a href="/species/{{ g.genus }}/index.html"><em>{{ g.genus }}</em></a>
        <span class="count">{{ g.specimen_count | quantify("specimen") }} · {{ g.inat_obs_count | quantify("community observation") }}</span>
      </li>
    {%- endfor -%}
    </ul>
  </div>
  {%- if tribe.taxon_id -%}
  <a class="taxon-action" href="/?taxon={{ tribe.taxon_id }}">View on atlas →</a>
  <a class="taxon-action" href="https://www.inaturalist.org/taxa/{{ tribe.taxon_id }}">View on iNaturalist →</a>
  {%- endif -%}
</article>
{% viteAssets "src/entries/taxon-page.ts" %}
