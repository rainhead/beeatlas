{% from "inline-nav.njk" import inlineNav %}
{% viteAssets "src/styles/places.css" %}
{#- Level IV ecoregions (beeatlas-8gcw, ADR 0035). Places in every pipeline sense —
    records, /places/{slug}.html pages, the `place=` filter — but a different kind of
    thing to read, and 57 of them, so they get their own page rather than a section at
    the bottom of the collecting-sites list. Their detail pages stay under /places/. -#}
<article class="places-page places-index">
  <h1>Ecoregions</h1>
  {{ inlineNav([
    { href: "/places.html", label: "Collecting sites" },
    { href: "/ecoregions.html", label: "Ecoregions", current: true }
  ], "Places") }}
  <p class="metadata">EPA Level IV ecoregions, grouped by the Level III ecoregion each subdivides. Unlike the collecting sites, these cover the whole state — every record sits inside one.</p>
  {%- for group in places.ecoregionGroups -%}
  <h2 class="ecoregion-l3">{{ group.l3_name }}</h2>
  <ul class="places-list">
    {%- for eco in group.ecoregions -%}
    <li>
      <a href="/places/{{ eco.slug }}.html">{{ eco.name }}</a>
      <span class="count">{{ eco.specimen_count | quantify("specimen") }}</span>
    </li>
    {%- endfor -%}
  </ul>
  {%- endfor -%}
</article>
