---
pagination:
  data: species.genusList
  size: 1
  alias: genus
permalink: "/species/{{ genus.genus }}/"
eleventyComputed:
  title: "{{ genus.genus }} — BeeAtlas"
layout: default.njk
---
<article class="taxon-page">
  {# Ladder built in _data/species.js — same builder every taxon page uses.
     Whitespace between crumbs is deliberate: it is the only wrap opportunity in
     the chain, and without it the full ladder overflows a phone viewport. #}
  <nav class="breadcrumb">
    {% for crumb in genus.crumbs %}
    {%- if not loop.first %}<span class="sep">/</span> {% endif -%}
    {% if crumb.href %}<a href="{{ crumb.href }}">{{ crumb.label }}</a>{% else %}{{ crumb.label }}{% endif %}
    {% endfor %}
  </nav>
  <h1><em>{{ genus.genus }}</em></h1>

  {# Identity band, same shape as the species page: photo beside the headline
     numbers, reusing .species-identity so this introduces no new layout rule.
     beeatlas-xrg — 39 genus entries hold 119 photos and nothing rendered them.

     Unlike the species page, no photo means NO BAND rather than a placeholder.
     10 of the 49 genera have no entry, and reserving half the viewport above the
     fold for a grey "No photo available" box is worse than the layout this
     replaced — on a species page the placeholder holds one cell of a grid that
     has other content to balance, here it would stand almost alone. #}
  {%- import "taxon-photos.njk" as taxonPhotos -%}
  {%- set genusPhotos = photos[genus.genus] -%}
  {%- if genusPhotos and genusPhotos.photos and genusPhotos.photos.length > 0 -%}
  <div class="species-identity">
    {{ taxonPhotos.gallery(genusPhotos, genus.genus) }}
    <p class="metadata">{{ genus.speciesCount | quantify("species", "species") }} · {{ genus.totalOccurrences | quantify("record") }}</p>
  </div>
  {%- else -%}
  <p class="metadata">{{ genus.speciesCount | quantify("species", "species") }} · {{ genus.totalOccurrences | quantify("record") }}</p>
  {%- endif -%}

  <div class="media-grid">
    <img loading="lazy"
         src="/data/species-maps/genus/{{ genus.genus }}.svg"
         alt="Occurrence map for genus {{ genus.genus }}"
         style="aspect-ratio: 15/8; width: 100%;">
    {# Single grid child so .media-grid stays 2-column (map | members); #}
    {# subgenus sections stack vertically inside it. #}
    <div class="taxon-members">
    {%- if genus.subgenera.length > 0 -%}
    {# Grouped layout: one <h2> per subgenus, then that subgenus's species list #}
    {%- for sg in genus.subgenera -%}
    <h2>{%- if sg.hasPage %}<a href="/species/{{ genus.genus }}/{{ sg.subgenus }}/index.html"><em>{{ sg.subgenus }}</em></a>{%- else %}<em>{{ sg.subgenus }}</em>{%- endif %}</h2>
    <ul class="species-list">
    {%- for sp in sg.species -%}
      <li>
        <span class="swatch" style="background: {{ sp.hexColor }};" aria-hidden="true"></span>
        {%- if sp.slug %}<a href="/species/{{ sp.slug }}/index.html"><em>{{ sp.scientificName }}</em></a>{%- else %}<em>{{ sp.scientificName }}</em>{%- endif %}
        {%- if sp.sociality -%}
        <span class="node-badge" tabindex="0"
              title="Sociality: {% if sp.sociality === 'Parasitic' %}Cleptoparasitic{% else %}{{ sp.sociality }}{% endif %} · {% if sp.sociality_source === 'beegap-species' %}Bee-Gap 2017{% elif sp.sociality_source === 'correction' %}corrected{% else %}Genus backbone{% endif %}">
          {%- if sp.sociality === 'Parasitic' %}Clepto{%- else %}{{ sp.sociality }}{%- endif -%}
        </span>
        {%- endif -%}
        {%- if sp.diet_breadth === 'specialist' -%}
        <span class="node-badge node-badge--specialist" tabindex="0"
              title="Diet: Specialist{% if sp.host_plant_family %} ({{ sp.host_plant_family }}){% endif %} · {% if sp.diet_breadth_source === 'fowler' %}Fowler &amp; Droege{% else %}Bee-Gap 2017{% endif %}">Specialist</span>
        {%- endif -%}
        {%- if sp.occurrence_count > 0 -%}
        <span class="count">{{ sp.specimen_count | quantify("specimen") }} · {{ sp.inat_obs_count | quantify("community observation") }}</span>
        {%- elif sp.on_checklist -%}
        <span class="count">{%- if sp.checklist_record_count > 0 -%}{{ sp.checklist_record_count | quantify("checklist record") }}{%- else -%}On checklist{%- endif -%}</span>
        {%- else -%}
        <span class="count">{{ 0 | quantify("record") }}</span>
        {%- endif -%}
      </li>
    {%- endfor -%}
    </ul>
    {%- endfor -%}
    {%- if genus.ungroupedSpecies.length > 0 -%}
    {# Trailing unheaded list for subgenus-less species and synthetic "Genus sp." entry #}
    <ul class="species-list">
    {%- for sp in genus.ungroupedSpecies -%}
      <li>
        <span class="swatch" style="background: {{ sp.hexColor }};" aria-hidden="true"></span>
        {%- if sp.slug %}<a href="/species/{{ sp.slug }}/index.html"><em>{{ sp.scientificName }}</em></a>{%- else %}<em>{{ sp.scientificName }}</em>{%- endif %}
        {%- if sp.sociality -%}
        <span class="node-badge" tabindex="0"
              title="Sociality: {% if sp.sociality === 'Parasitic' %}Cleptoparasitic{% else %}{{ sp.sociality }}{% endif %} · {% if sp.sociality_source === 'beegap-species' %}Bee-Gap 2017{% elif sp.sociality_source === 'correction' %}corrected{% else %}Genus backbone{% endif %}">
          {%- if sp.sociality === 'Parasitic' %}Clepto{%- else %}{{ sp.sociality }}{%- endif -%}
        </span>
        {%- endif -%}
        {%- if sp.diet_breadth === 'specialist' -%}
        <span class="node-badge node-badge--specialist" tabindex="0"
              title="Diet: Specialist{% if sp.host_plant_family %} ({{ sp.host_plant_family }}){% endif %} · {% if sp.diet_breadth_source === 'fowler' %}Fowler &amp; Droege{% else %}Bee-Gap 2017{% endif %}">Specialist</span>
        {%- endif -%}
        {%- if sp.occurrence_count > 0 -%}
        <span class="count">{{ sp.specimen_count | quantify("specimen") }} · {{ sp.inat_obs_count | quantify("community observation") }}</span>
        {%- elif sp.on_checklist -%}
        <span class="count">{%- if sp.checklist_record_count > 0 -%}{{ sp.checklist_record_count | quantify("checklist record") }}{%- else -%}On checklist{%- endif -%}</span>
        {%- else -%}
        <span class="count">{{ 0 | quantify("record") }}</span>
        {%- endif -%}
      </li>
    {%- endfor -%}
    </ul>
    {%- endif -%}
    {%- else -%}
    {# D-05 fallback: no subgenera — flat species list unchanged #}
    <ul class="species-list">
    {%- for sp in genus.species -%}
      <li>
        <span class="swatch" style="background: {{ sp.hexColor }};" aria-hidden="true"></span>
        {%- if sp.slug %}<a href="/species/{{ sp.slug }}/index.html"><em>{{ sp.scientificName }}</em></a>{%- else %}<em>{{ sp.scientificName }}</em>{%- endif %}
        {%- if sp.sociality -%}
        <span class="node-badge" tabindex="0"
              title="Sociality: {% if sp.sociality === 'Parasitic' %}Cleptoparasitic{% else %}{{ sp.sociality }}{% endif %} · {% if sp.sociality_source === 'beegap-species' %}Bee-Gap 2017{% elif sp.sociality_source === 'correction' %}corrected{% else %}Genus backbone{% endif %}">
          {%- if sp.sociality === 'Parasitic' %}Clepto{%- else %}{{ sp.sociality }}{%- endif -%}
        </span>
        {%- endif -%}
        {%- if sp.diet_breadth === 'specialist' -%}
        <span class="node-badge node-badge--specialist" tabindex="0"
              title="Diet: Specialist{% if sp.host_plant_family %} ({{ sp.host_plant_family }}){% endif %} · {% if sp.diet_breadth_source === 'fowler' %}Fowler &amp; Droege{% else %}Bee-Gap 2017{% endif %}">Specialist</span>
        {%- endif -%}
        {%- if sp.occurrence_count > 0 -%}
        <span class="count">{{ sp.specimen_count | quantify("specimen") }} · {{ sp.inat_obs_count | quantify("community observation") }}</span>
        {%- elif sp.on_checklist -%}
        <span class="count">{%- if sp.checklist_record_count > 0 -%}{{ sp.checklist_record_count | quantify("checklist record") }}{%- else -%}On checklist{%- endif -%}</span>
        {%- else -%}
        <span class="count">{{ 0 | quantify("record") }}</span>
        {%- endif -%}
      </li>
    {%- endfor -%}
    </ul>
    {%- endif -%}
    </div>
  </div>
  {%- if genus.taxon_id -%}
  <a class="taxon-action" href="/?taxon={{ genus.taxon_id }}">View on atlas →</a>
  <a class="taxon-action" href="https://www.inaturalist.org/taxa/{{ genus.taxon_id }}">View on iNaturalist →</a>
  {%- endif -%}
</article>
{% viteAssets "src/entries/taxon-page.ts" %}
