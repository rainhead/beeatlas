# 03:00 Pacific, the hour the Machine's nightly ran (fly/crontab). Persistent: a run
# missed while Hostess was asleep or off happens once when it wakes or next boots,
# whatever the hour; the service waits for the network to come back first. It runs
# at Nice=10 (the service), so it yields to whatever else Hostess is doing.
[Unit]
Description=BeeAtlas nightly data build, 03:00 Pacific

[Timer]
OnCalendar=*-*-* 03:00:00 America/Los_Angeles
Persistent=true
Unit=beeatlas-nightly.service

[Install]
WantedBy=timers.target
